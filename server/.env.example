# Server Environment Variables (Template)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/futuristic_thinkers?retryWrites=true&w=majority

# JWT Secrets (Generate strong random 64-character strings)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_random
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_random
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=true

# Client URL for CORS
CLIENT_URL=https://your-client-app.vercel.app

# Email / SMTP Settings (Resend, Brevo, SendGrid, Mailtrap)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_smtp_api_key
EMAIL_FROM="Futuristic Thinkers" <support@futuristicthinkers.com>

# Stripe Payment Keys (Test or Live)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Cloudinary Storage (Optional file upload CDN)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Initial Admin Setup
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=YourStrongAdminPassword123!
